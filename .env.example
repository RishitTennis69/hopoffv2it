# Copy this file to ".env" and fill in your keys.
# Variables must be prefixed with EXPO_PUBLIC_ to be available in the app.

# YouTube Data API v3 key (https://console.cloud.google.com/ -> enable
# "YouTube Data API v3" -> Credentials -> API key). Used for video search.
# If left empty, the app uses a built-in mock search dataset.
EXPO_PUBLIC_YOUTUBE_API_KEY=

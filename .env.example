# Copy this file to ".env" for local public runtime config, or set the value in
# EAS environment variables. EXPO_PUBLIC_* values are embedded in the app bundle,
# so never put API keys, database URLs, service_role keys, or OAuth secrets here.
# Restart Metro with cache clear after changes: npx expo start -c

# Public base URL for your hardened backend proxy. The proxy owns secret access
# to YouTube/OpenRouter, validates every request, applies rate limits, restricts
# CORS to known app/web origins, and returns generic errors.
EXPO_PUBLIC_HOPOFF_API_BASE_URL=

# Server-side only, shown here as documentation for the proxy environment:
# YOUTUBE_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional HTTPS webhook for AI content reports (Slack/Discord/Make/Zapier/custom).
# HOPOFF_REPORT_WEBHOOK_URL=

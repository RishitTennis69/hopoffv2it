{
  "expo": {
    "name": "HopOff",
    "slug": "hopoffv2it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hopoff",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "buildNumber": "6",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow HopOff to transcribe your spoken goals.",
        "NSMicrophoneUsageDescription": "Allow HopOff to use the microphone for voice goal entry."
      }
    },
    "android": {
      "package": "com.gethopoff.app",
      "versionCode": 9,
      "userInterfaceStyle": "dark",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "./plugins/withHopOffAndroid",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow HopOff to use the microphone for voice goal entry.",
          "speechRecognitionPermission": "Allow HopOff to transcribe your spoken goals."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "895c21d4-60d8-4812-86db-90028174a39a"
      }
    },
    "owner": "courtmateeee"
  }
}
